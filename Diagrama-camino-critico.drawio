        <mxCell id="r0" value="Referencias del diagrama CPM — N.º de actividad, nombre del Gantt, duración y predecesoras (dependencias propuestas; ver planilla de cálculos)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;whiteSpace=nowrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="&lt;table style=&quot;border-collapse:collapse;font-size:11px;font-family:Helvetica,Arial,sans-serif;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#f8cecc;&quot;&gt;N.º&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#f8cecc;&quot;&gt;Actividad (nombre del Gantt)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#f8cecc;&quot;&gt;Dur. (min)&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:2px 6px;background:#f8cecc;&quot;&gt;Predecesoras&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;&quot;&gt;Relevar necesidades de usuarios sobre administración de finanzas personales&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:center;&quot;&gt;15&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:center;&quot;&gt;INICIO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:center;&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;&quot;&gt;Detallar RF01 – Gestión de usuarios&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:center;&quot;&gt;20&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:center;&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;&quot;&gt;Detallar RF02 – Gestión de movimientos&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:center;&quot;&gt;15&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:2px 6px;text-align:center;&quot;&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding: